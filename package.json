{
    "name": "mini-clojure-ts",
    "version": "8.0.0",
    "description": "Interpretador, REPL e transpilador de um subset de Clojure escrito em TypeScript.",
    "main": "./dist/index.js",
    "type": "module",
    "scripts": {
        "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/post-build.mjs",
        "typecheck": "tsc -p tsconfig.check.json",
        "start": "tsx src/cli.ts",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "tsx --test tests/**/*.test.ts",
        "prepare": "husky || true",
        "clean": "rm -rf dist",
        "prepack": "pnpm build"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx}": [
            "prettier --write",
            "eslint --fix"
        ],
        "**/*.{html,json,css,scss,md,mdx}": [
            "prettier -w"
        ]
    },
    "keywords": [
        "clojure",
        "lisp",
        "interpreter",
        "transpiler",
        "repl",
        "typescript"
    ],
    "author": "Bruno Lima Soares",
    "license": "MIT",
    "packageManager": "pnpm@10.27.0",
    "devDependencies": {
        "@commitlint/cli": "^20.3.0",
        "@commitlint/config-conventional": "^20.3.0",
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "esbuild": "^0.27.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "^3.7.4",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime/index.d.ts",
            "browser": "./dist/runtime/index.js",
            "import": "./dist/runtime/node.js",
            "require": "./dist/cjs/runtime/node.js"
        },
        "./runtime/browser": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js"
        },
        "./package.json": "./package.json",
        "./browser": {
            "types": "./dist/browser/index.d.ts",
            "import": "./dist/browser/index.js"
        }
    },
    "bin": {
        "mini-clj": "./dist/cli.js"
    },
    "files": [
        "dist",
        "docs",
        "examples",
        "README.md",
        "ROADMAP.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BrunoL28/mini-clojure-ts.git"
    }
}
